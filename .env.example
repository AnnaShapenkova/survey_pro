# Local connection. In Coolify the compose file sets the internal connection.
DATABASE_URL=postgresql://research:change-me@localhost:5432/survey_research
SERVICE_USER_POSTGRES=research
SERVICE_PASSWORD_POSTGRES=
OPENROUTER_API_KEY=
# Available chat model ID from your OpenRouter account; required for analysis.
MODEL=
# Multilingual embedding model ID. Empty = keyword search only.
EMBEDDING_MODEL=openai/text-embedding-3-small
TELEGRAM_TOKEN=
# Comma-separated private chat IDs; /id works before access is granted.
TELEGRAM_ALLOWED_CHAT_IDS=
# Public HTTPS root of the bot service; the app opens /telegram inside Telegram.
MINI_APP_URL=
WEB_USER=research
WEB_PASSWORD=
DIGEST_TIMEZONE=Europe/Moscow
DIGEST_HOUR=9
COLLECT_INTERVAL_SECONDS=86400
GITHUB_TOKEN=
# DATA_DIR=/data
# ANALYSIS_MAX_CHUNKS=40
